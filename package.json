{
  "name": "secret-santa",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://emauss.github.io/secret-santa",
  "type": "module",
  "scripts": {
    "dev:gorczynscy": "vite --host --mode gorczynscy",
    "dev:okroj": "vite --host --mode okroj",
    "build:gorczynscy": "tsc -b && vite build --mode gorczynscy",
    "build:okroj": "tsc -b && vite build --mode okroj",
    "deploy:gorczynscy": "pnpm build:gorczynscy && gh-pages -d build",
    "deploy:okroj": "pnpm build:okroj && firebase deploy --only hosting --project okroj",
    "deploy:all": "pnpm deploy:gorczynscy && pnpm deploy:okroj",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "canvas-confetti": "^1.9.3",
    "firebase": "^12.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "react-snowfall": "^2.3.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-tools": "^15.35.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.6"
  }
}
